DATABASE_URL=mysql://root:@127.0.0.1:3307/azdkth_db_v_2

# Public JSON API (consumed by the Vue frontend)
# SERVER_PORT=4000
SERVER_PORT=127.0.0.1:4000

# FRONTEND_ORIGIN=https://azadirkotha.com
FRONTEND_ORIGIN=http://localhost:8080

# Admin dashboard (separate listener, never expose publicly without a reverse proxy/VPN)
# ADMIN_BIND=127.0.0.1:3000
ADMIN_BIND=127.0.0.1:3000

# Set to true once the admin is served over HTTPS
COOKIE_SECURE=false

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# First-run admin seed (remove ADMIN_PASSWORD from this file after the first successful start)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChangeMe-Now-12345"
ADMIN_NAME="Site Administrator"
ADMIN_EMAIL="admin@example.com"
ADMIN_PHONE="0000000000"

UPLOAD_DIR=uploads

# PUBLIC_BASE_URL=https://admin.azadirkotha.com/api
PUBLIC_BASE_URL=http://127.0.0.1:4000

# SITE_URL=https://azadirkotha.com
SITE_URL=http://localhost:8080
SITE_NAME="The Daily Azadir Kotha"
